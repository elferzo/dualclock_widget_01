<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@android:color/transparent"
    android:padding="8dp">

    <!-- City 1: Astrakhan -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:padding="12dp">

        <TextView
            android:id="@+id/city1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Астрахань"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="normal"
            android:gravity="center"
            android:alpha="0.9"/>

        <TextView
            android:id="@+id/city1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-light"/>

        <TextView
            android:id="@+id/city1_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="пн 1 янв"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:alpha="0.75"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#44FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- City 2: Kogalym -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:padding="12dp">

        <TextView
            android:id="@+id/city2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Когалым"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="normal"
            android:gravity="center"
            android:alpha="0.9"/>

        <TextView
            android:id="@+id/city2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-light"/>

        <TextView
            android:id="@+id/city2_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="пн 1 янв"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:alpha="0.75"/>

    </LinearLayout>

</LinearLayout>
