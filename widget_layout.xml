<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="4dp">

    <!-- City 1: Astrakhan (left half) -->
    <TextView
        android:id="@+id/city1_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:text="Астрахань"
        android:textColor="#FFFFFF"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/city1_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/city1_name"
        android:layout_alignLeft="@id/city1_name"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/city1_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/city1_time"
        android:layout_alignLeft="@id/city1_name"
        android:text="пн 1 янв"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"/>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:background="#44FFFFFF"/>

    <!-- City 2: Kogalym (right half) -->
    <TextView
        android:id="@+id/city2_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@id/divider"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="4dp"
        android:text="Когалым"
        android:textColor="#FFFFFF"
        android:textSize="13sp"/>

    <TextView
        android:id="@+id/city2_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/city2_name"
        android:layout_alignLeft="@id/city2_name"
        android:text="00:00"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/city2_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/city2_time"
        android:layout_alignLeft="@id/city2_name"
        android:text="пн 1 янв"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"/>

</RelativeLayout>
